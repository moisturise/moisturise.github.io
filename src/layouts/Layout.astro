---
import '../styles/global.css';
import background from "../assets/background.svg";
import teaLogo from "../assets/tea.svg";
import Menu from "../components/Hamburger.astro";
import Cart from "../components/Cart.astro";

interface Props {
	title?: string;
}
const { title } = Astro.props;
const defaultTitle =
	"Fermented teas and rare brews, ethically sourced for the curious, creative palates - Formosa Tea Club";
---

<!doctype html>
<html lang="en" style="background-color:#171c27;">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Fermented teas and rare brews, ethically sourced from the mountains of Taiwan."
		/>
		<title>{title ? `${title} - Formosa Tea Club` : defaultTitle}</title>

		<!-- Social share preview — applies to every page -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Formosa Tea Club" />
		<meta property="og:title" content="Formosa Tea Club — Fermented teas & rare brews" />
		<meta property="og:description" content="Ethically sourced from the mountains of Taiwan for the curious, creative palates." />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
		<meta property="og:image" content="https://formosatea.club/images/preview.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Formosa Tea Club — Fermented teas & rare brews" />
		<meta name="twitter:description" content="Ethically sourced from the mountains of Taiwan for the curious, creative palates." />
		<meta name="twitter:image" content="https://formosatea.club/images/preview.png" />

		<!-- Per-page <head> additions (JSON-LD, page-specific overrides, etc.) -->
		<slot name="head" />

		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "Formosa Tea Club",
			"description": "Fermented teas and rare brews, ethically sourced for the curious, creative palates.",
			"url": "https://formosatea.club",
			"logo": "https://formosatea.club/images/logo.svg",
			"email": "hello@formosatea.club",
			"sameAs": ["https://www.instagram.com/formosatea.club"],
			"contactPoint": [
				{ "@type": "ContactPoint", "email": "hello@formosatea.club", "url": "https://formosatea.club" }
			]
		})} />
	</head>
	<body>
		<Cart />
		<br /><br /><br /><br /><br /><br />
		<img id="background" src={background.src} alt="" fetchpriority="high" />
		<a href="/">
			<img
				id="teaLogo"
				src={teaLogo.src}
				width="400"
				height="400"
				alt="Formosa Tea Club"
			/>
		</a>
		<br />
		<Menu />
		<main class="page">
			<slot />
		</main>
	</body>
</html>
