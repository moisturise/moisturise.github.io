---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---
<Layout>
  <html>
    <head>
      <title>{frontmatter.title}</title>
    </head>
    <body>
      <hgroup>
        <h1>{frontmatter.title}</h1>
        <p class="blog-description">{frontmatter.description}</p>
      </hgroup>
      <br>
      <slot />
    </body>
  </html>
</Layout>

<style>
.blog-description {
    font-style: italic;
}
</style>