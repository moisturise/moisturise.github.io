---
import Layout from "../layouts/Layout.astro";
import img_01 from "../assets/01.jpg";
import img_03 from "../assets/03.jpg";
import img_04 from "../assets/04.jpeg";
import teacup from "../../public/favicon.svg"

const title = "About";
const posts = [
    {
        title: "Forager's Delight: A Tea From a Species Older Than the Idea of Tea Farming",
        image: img_04,
        slug: "/posts/foragers-delight",
        date: "07 Sept 2026"
    },
    {
        title: "Taiwanese High-Mountain Oolong Tea: Wellness FAQ",
        image: img_03,
        slug: "/posts/wellnessfaq",
        date: "25 Jan 2026"
    },
    {
        title: "The Calming Practice of Oolong Tea",
        image: img_01,
        slug: "/posts/calmingpractice",
        date: "23 Jan 2026"
    }
]
---

<Layout title={title}>
  <p class="short-text-centre">Fermented teas and rare brews from Taiwan via London, UK.<br>Ethically sourced for curious, creative palates.<br><br>Read more about our tea  ↓</p>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    .container {
      max-width: 935px;
      margin: 0 auto;
      padding: 2%;
      /* direction: rtl; */
    }

    header {
      text-align: center;
      margin-bottom: 40px;
    }

    /* h1 {
      font-size: 2rem;
      color: #262626;
      margin-bottom: 10px;
    } */

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    @media (max-width: 768px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 3px;
      }
      .container {
        max-width: 0;
        padding: 0;
        width: 100vw;
        margin-left: 50%;
        transform: translateX(-50%);
      }
    }

    @media (max-width: 480px) {
      .grid {
        gap: 2px;
      }
    }

    .post-card {
      position: relative;
      aspect-ratio: 1;
      overflow: hidden;
      cursor: pointer;
      text-decoration: none;
    }

    .post-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .post-card:hover .post-image {
      transform: scale(1.05);
    }

    .post-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .post-card:hover .post-overlay {
      opacity: 1;
    }

    .post-title {
      color: white;
      font-size: 1.1rem;
      font-weight: 600;
      text-align: center;
      padding: 20px;
    }

    @media (max-width: 768px) {
      .post-title {
        font-size: 0.9rem;
        padding: 10px;
      }
    }
  </style>
    <body>
    <div class="container">
        <div class="grid">
        {posts.map((post) => (
            <a href={post.slug} class="post-card">
            <img 
                src={post.image.src} 
                alt={post.title}
                class="post-image"
                loading="lazy"
            />
            <div class="post-overlay">
                <h2 class="post-title">{post.title}</h2>
            </div>
            </a>
        ))}
        </div>
    </div>
    </body>
</Layout>
