---
import Layout from "../layouts/Layout.astro";

const title = "Posts";
const posts = [
    {
        title: "The Calming Practice of Oolong Tea",
        image: "src/assets/a01.jpg",
        slug: "/posts/calmingpractice",
        date: "23 Jan 2026"
    }
]
---

<Layout title={title}>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: #fafafa;
      padding: 20px;
    } */

    .container {
      max-width: 935px;
      margin: 0 auto;
    }

    header {
      text-align: center;
      margin-bottom: 40px;
    }

    /* h1 {
      font-size: 2rem;
      color: #262626;
      margin-bottom: 10px;
    } */

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    @media (max-width: 768px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 3px;
      }
    }

    @media (max-width: 480px) {
      .grid {
        gap: 2px;
      }
    }

    .post-card {
      position: relative;
      aspect-ratio: 1;
      overflow: hidden;
      cursor: pointer;
      text-decoration: none;
    }

    .post-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .post-card:hover .post-image {
      transform: scale(1.05);
    }

    .post-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .post-card:hover .post-overlay {
      opacity: 1;
    }

    .post-title {
      color: white;
      font-size: 1.1rem;
      font-weight: 600;
      text-align: center;
      padding: 20px;
    }

    @media (max-width: 768px) {
      .post-title {
        font-size: 0.9rem;
        padding: 10px;
      }
    }
  </style>
    <body>
    <div class="container">
        <div class="grid">
        {posts.map((post) => (
            <a href={post.slug} class="post-card">
            <img 
                src={post.image} 
                alt={post.title}
                class="post-image"
                loading="lazy"
            />
            <div class="post-overlay">
                <h2 class="post-title">{post.title}</h2>
            </div>
            </a>
        ))}
        </div>
    </div>
    </body>
</Layout>
