---
import Layout from "../layouts/Layout.astro";
import AddToCartButton from "../components/AddToCartButton.astro";
import { teas } from "../data/teas.js";

const title = "Our Teas";

// Product structured data (with offers/price) generated from the same
// catalogue that renders the cards below, so the two never drift apart.
const productJsonLd = {
	"@context": "https://schema.org",
	"@graph": teas.map((tea) => ({
		"@type": "Product",
		name: tea.name,
		description: tea.shortDescription,
		brand: { "@type": "Brand", name: "Formosa Tea Club" },
		offers: {
			"@type": "Offer",
			price: tea.price.toFixed(2),
			priceCurrency: "GBP",
			availability: "https://schema.org/InStock",
			url: "https://formosatea.club/tea",
		},
	})),
};
---

<Layout title={title}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
	</Fragment>

	<section class="tea-collection">
		{teas.map((tea) => (
			<article class="tea-item">
				<h2 class="tea-name">{tea.name}</h2>
				<p class="tea-origin">Origin: {tea.origin}</p>
				<p class="tea-scene">{tea.scene}</p>
				<p class="tea-description" set:html={tea.description} />
				<div class="tea-buy">
					<span class="tea-price">£{tea.price.toFixed(2)}</span>
					<AddToCartButton slug={tea.slug} name={tea.name} price={tea.price} />
				</div>
			</article>
		))}
	</section>

	<style>
		.tea-collection {
			font-family: "Helvetica Neue", sans-serif;
			color: #b2d8c8; /* soft green base */
			line-height: 1.7;
			max-width: 100%;
			margin: 0 auto;
		}

		.tea-item {
			margin-bottom: 3rem;
			border-bottom: 1px solid #325144;
			padding-bottom: 2rem;
		}

		.tea-name {
			font-size: 1.6rem;
			font-weight: bold;
			color: #e6fbf1; /* primary light green accent */
			margin-bottom: 0.25rem;
		}

		.tea-origin {
			font-style: italic;
			font-size: 0.95rem;
			margin-bottom: 1rem;
			color: #a0cabc;
		}

		.tea-scene {
			font-weight: 500;
			color: #d1f5e3;
			margin-bottom: 0.75rem;
		}

		.tea-description {
			margin-bottom: 1rem;
			color: #c1e8da;
		}

		.tea-buy {
			display: flex;
			align-items: center;
			gap: 1rem;
		}

		.tea-price {
			font-size: 1.2rem;
			font-weight: bold;
			color: #e6fbf1;
		}

		em {
			font-style: italic;
			color: #e6fbf1;
		}
	</style>
</Layout>
